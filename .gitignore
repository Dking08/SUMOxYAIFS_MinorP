vsumof/
venv/
.venv/
**/__pycache__/
*.pyc

# SUMO generated runtime outputs (ignore)
sumoXyafs/sumo/**/fcd.xml
sumoXyafs/sumo/**/fog_test.fcd.xml
sumoXyafs/sumo/**/edgeData.xml
sumoXyafs/sumo/**/fog_test.edgeData.xml
