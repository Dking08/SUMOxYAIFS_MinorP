<?xml version="1.0" encoding="UTF-8"?>

<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="osm.net.xml.gz"/>
        <route-files value="fog_test.trips.xml"/>
        <additional-files value="osm.poly.xml.gz,fog_test.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="700"/>
        <step-length value="1"/>
    </time>

    <output>
        <tripinfo-output value="fog_test.tripinfos.xml"/>
        <statistic-output value="fog_test.stats.xml"/>
        <fcd-output value="fog_test.fcd.xml"/>
    </output>

    <processing>
        <ignore-route-errors value="true"/>
        <time-to-teleport value="90"/>
        <tls.actuated.jam-threshold value="30"/>
    </processing>

    <routing>
        <device.rerouting.adaptation-steps value="18"/>
        <device.rerouting.adaptation-interval value="10"/>
    </routing>

    <max-num-vehicles value="220"/>

    <report>
        <verbose value="false"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="fog_test.view.xml"/>
    </gui_only>
</sumoConfiguration>
